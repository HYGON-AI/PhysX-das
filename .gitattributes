# Normalize text files to LF in the repository and in the working tree.
# Native line endings are not required by any platform this project targets,
# and mixed line endings break the automated compliance scanners.
* text=auto eol=lf

# Binary assets that must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.bmp binary
*.tga binary
*.dds binary
*.exr binary
*.hdr binary
*.ktx binary
*.bin binary
*.so binary
*.so.* binary
*.dylib binary
*.dll binary
*.lib binary
*.a binary
*.o binary
*.obj binary
*.hsaco binary
*.cubin binary
*.ptx binary
*.class binary
*.jar binary
*.zip binary
*.gz binary
*.tgz binary
*.bz2 binary
*.xz binary
*.7z binary
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary
*.fbx binary
*.usd binary
*.usda text
*.usdc binary
*.usdz binary
*.mesh binary
*.sqlite binary
*.db binary

# Git LFS pointer files must keep their exact bytes.
*.psd -text
*.psb -text

# Explicit text formats so the intent survives future tooling changes.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cu text eol=lf
